# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# AI Assistant (OpenAI-compatible: OpenRouter, OpenAI, DeepSeek, Groq, …)
# -------------------------------------------------------------
# Create a key at https://openrouter.ai/keys and paste it below.
# NOTE: never commit a real key to this file — it is public by design.
AI_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY
AI_BASE_URL=https://openrouter.ai/api/v1

# Primary chat model + automatic fallbacks (tried in order on provider failure).
# Free models with large context and tool support:
AI_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
AI_CHAT_FALLBACK_MODELS=qwen/qwen3.8-27b:free,inclusionai/ling-3.0-flash-sante:free

# Lightweight model for conversation summarization (context compression).
AI_SUMMARIZE_MODEL=nvidia/nemotron-3.5-lightning:free
AI_SUMMARIZE_FALLBACK_MODELS=qwen/qwen3.8-27b:free

# Tuning
AI_CHAT_MAX_TOKENS=4096
AI_SUMMARIZE_MAX_TOKENS=2048
# AI_CHAT_MAX_TOKENS=8192      — max output tokens per chat request
# AI_MAX_RETRIES=2             — server-side retries for 429/5xx (Retry-After aware)
# AI_TIMEOUT_MS=120000         — per-request timeout in ms
# AI_STREAM_INCLUDE_USAGE=true — set false only for endpoints rejecting stream_options
# AI_PROVIDER=openai-compatible — provider adapter (see app/api/ai/providers/)

# Alternative: OpenAI directly
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o
# AI_SUMMARIZE_MODEL=gpt-4o-mini
# AI_CHAT_FALLBACK_MODELS=
